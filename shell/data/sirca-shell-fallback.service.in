[Unit]
Description=Sirca Shell kept crashing: give the Plasma panels back

[Service]
Type=oneshot
ExecStart=@SIRCA_SHELL_BINDIR@/sirca-shell-switch off
ExecStartPost=-/usr/bin/notify-send -a "Sirca Shell" -i dialog-warning "Sirca Shell failed repeatedly" "The Plasma panels were restored. Run 'sirca-shell-switch on' to try again; see 'journalctl --user -u sirca-shell'."
