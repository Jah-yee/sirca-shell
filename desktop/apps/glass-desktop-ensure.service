[Unit]
Description=Glass Desktop: re-assert the look at login (repairs drift only)
PartOf=graphical-session.target
After=plasma-kwin_wayland.service plasma-plasmashell.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 8
# point this at wherever you keep the repository
ExecStart=%h/glass-desktop/tools/ensure_session.sh

[Install]
WantedBy=graphical-session.target
